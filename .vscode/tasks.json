{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NovaPi: Deploy & Serial Monitor",
      "type": "shell",
      "command": "python ../NovaPi/scripts/firefly_upload.py -p COM8 -i main.py -o /main.py; if ($?) { mpremote connect COM8 repl }",
      "linux": {
        "command": "python3 \"$HOME/.vscode/extensions/makeblock-community.novapi-companion-0.1.0/scripts/upload_python3.py\" /dev/ttyUSB0 main.py /main.py && mpremote connect /dev/ttyUSB0 repl"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    }
  ]
}
